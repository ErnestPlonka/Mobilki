<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Domek w górach"
        android:textSize="28sp"
        android:textColor="#808080"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <ImageView
        android:id="@+id/ivObraz"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:src="@drawable/obraz"
        android:scaleType="centerCrop"
        android:contentDescription="Widok górskiego domku" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#008080">

        <Button
            android:id="@+id/btnPolub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="POLUB"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#008080"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnUsun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="USUŃ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#008080"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnZapisz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ZAPISZ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#008080"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPolubienia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 polubień"
        android:textSize="12sp"
        android:textColor="#808080"
        android:gravity="end"
        android:padding="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#808080" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opis"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#808080"
        android:paddingTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych"
        android:textSize="14sp"
        android:textColor="#808080"
        android:paddingTop="4dp" />

</LinearLayout>
